# ============================================================
# 高校应急安全管理系统 — 环境配置模板
# 复制此文件为 .env 并根据实际环境修改
# ============================================================

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_safety
DB_USERNAME=postgres
DB_PASSWORD=

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 服务端口 =====
SERVER_PORT=8088
AI_SERVICE_PORT=8089
FRONTEND_PORT=5173

# ===== Spring Profile =====
# local: 本地开发  |  demo: 比赛演示  |  minimal: 最小启动(无Redis)
SPRING_PROFILES_ACTIVE=local
