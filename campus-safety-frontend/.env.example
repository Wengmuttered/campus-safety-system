# ============================================================
# 前端环境变量模板
# 复制为 .env.local 并根据实际环境修改
# ============================================================

# 后端 API 地址（开发环境通过 vite proxy 转发，留空即可）
VITE_API_BASE_URL=

# WebSocket 地址
VITE_WS_URL=http://localhost:8088/ws

# Cesium CDN（留空使用默认多源回退）
VITE_CESIUM_CDN=

# 底图：true=在线瓦片（默认）；false=本地 /api/tiles 离线 MBTiles
VITE_USE_ONLINE_BASEMAP=true
# 在线底图：gaode（默认，高德路网）| gaode-satellite | carto | osm（高德为 GCJ-02，与接口 WGS84 会偏）
VITE_ONLINE_TILE_PROVIDER=gaode

# 天地图 key（后端 application.yml / 环境变量 TIANDITU_TK），与数据库图层中的天地图瓦片配套
# TIANDITU_TK=
